# 本番.envサンプル。bootstrap.shが.envを自動生成するので、通常はこのファイルを手で編集する必要はない。
DOMAIN_SIGNALING=passist.paps.jp
DOMAIN_TURN=turn.paps.jp
PUBLIC_BASE_URL=https://passist.paps.jp
ACME_EMAIL=paps@paps.jp
EXTERNAL_IP=160.16.206.193
ACCESS_MODE=approve
SESSION_TTL_MS=1800000

# 使用する signaling image のタグ。GHCR の Cosign 署名済 image を pull する。
# 利用者が cosign verify できるよう、必ず特定タグを固定する（latest は使わない）。
SIGNALING_VERSION=v0.2.7

# TURN realm。クライアントから見える認証ラベル。paps.jpドメイン共通の汎用ラベルにすると複数アプリで共有可能
REALM=paps.jp

# TURN マスタ secret（signaling サーバのみ保持）。漏洩=全TURN危険。bootstrap.shが openssl rand で自動生成。
# 各 TURN サーバは、この値から HMAC-SHA256(master, turn_url) で派生した鍵だけを持つ。
TURN_AUTH_SECRET=

# このVPSのcoturnが使う派生鍵。signalingが「自分宛て」の credential を生成するときと同じ鍵。
# bootstrap.shで TURN_AUTH_SECRET から SIGN_TURN_URLS[0] に対して自動派生する。
# 別VPSでTURNだけ立てる場合は、signalingで派生済みの値だけをここに設定する（マスタは渡さない）。
THIS_TURN_AUTH_SECRET=

# signaling が viewer に配布する TURN（ラウンドロビン用にカンマ区切りで複数指定可）。
# 例: turn:turn.paps.jp:3478,turn:turn2.paps.jp:3478
SIGN_TURN_URLS=turn:turn.paps.jp:3478

# 動的 bitrate ガバナ（TURN中継のみ適用）
RELAY_BUDGET_BPS=4000000
RELAY_MIN_BPS=100000
RELAY_MAX_BPS=1500000

# TURN認証（bootstrap.shが openssl rand -hex 16 で自動生成）
TURN_PASSWORD=
