# 本番.envサンプル。bootstrap.shが.envを自動生成するので、通常はこのファイルを手で編集する必要はない。
DOMAIN_SIGNALING=passist.paps.jp
DOMAIN_TURN=turn.paps.jp
PUBLIC_BASE_URL=https://passist.paps.jp
ACME_EMAIL=paps@paps.jp
EXTERNAL_IP=160.16.206.193
ACCESS_MODE=approve
SESSION_TTL_MS=1800000

# 動的 bitrate ガバナ（TURN中継のみ適用）
RELAY_BUDGET_BPS=4000000
RELAY_MIN_BPS=100000
RELAY_MAX_BPS=1500000

# TURN認証（bootstrap.shが openssl rand -hex 16 で自動生成）
TURN_PASSWORD=
