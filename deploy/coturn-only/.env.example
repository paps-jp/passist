# TURN専用VPSの .env サンプル。署名計算は signaling 側で行ってこの3つを受け取るだけ。
# 1) signaling で派生鍵を計算:
#    node -e "console.log(require('crypto').createHmac('sha256',process.env.TURN_AUTH_SECRET).update('turn:turn2.paps.jp:3478').digest('hex'))"
# 2) この .env に貼り付け
# 3) bootstrap-turn.sh を実行（UFW・docker導入・turnserver.conf生成・compose up）

TURN_URL=turn:turn2.paps.jp:3478
THIS_TURN_AUTH_SECRET=    # 上のコマンドで得た 64 文字hex
EXTERNAL_IP=              # この VPS のグローバルIPv4
REALM=paps.jp

# signaling 側で受け付けてもらう接続先と帯域
SIGNALING_URL=https://passist.paps.jp
BUDGET_BPS=4000000
